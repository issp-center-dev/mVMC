{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "power_lanczos_observable_scaling_raw_schema_v2.json",
  "title": "P6-C2 observable scaling append-only process record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "protocol_id", "timer_id", "erratum_id", "request", "input", "provenance", "process", "metrics", "artifacts"],
  "properties": {
    "schema_version": {"const": 2},
    "record_id": {"type": "string", "pattern": "^(warmup|measured|parity|selftest)-SC-[A-Z-]+-R(001|032|128|512)-rep[0-6]-mpi(1|2|4)$"},
    "protocol_id": {"const": "p6c2-operator-count-scaling-v2"},
    "timer_id": {"const": "p6c2_observable_source_batch_v2"},
    "erratum_id": {"const": "power-lanczos-p6c2-observable-scaling-erratum-v2"},
    "request": {"$ref": "#/$defs/request"},
    "input": {"$ref": "#/$defs/input"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "process": {"$ref": "#/$defs/process"},
    "metrics": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/metrics"}]},
    "artifacts": {"type": "array", "minItems": 0, "maxItems": 2, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegativeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stratum_id", "operator_count", "saved_source_count", "replicate_ordinal", "run_kind", "mpi_world_size", "timing_seed_sha256"],
      "properties": {
        "stratum_id": {"enum": ["SC-ONEBODY", "SC-QUARTIC", "SC-MIXED", "SC-LOW-REUSE"]},
        "operator_count": {"enum": [1, 32, 128, 512]},
        "saved_source_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "replicate_ordinal": {"type": "integer", "minimum": 0, "maximum": 6},
        "run_kind": {"enum": ["warmup", "measured", "parity", "selftest"]},
        "mpi_world_size": {"enum": [1, 2, 4]},
        "timing_seed_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "input_sha256", "family_counts"],
      "properties": {"manifest_sha256": {"$ref": "#/$defs/sha256"}, "input_sha256": {"$ref": "#/$defs/sha256"}, "family_counts": {"$ref": "#/$defs/familyCounts"}}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "source_diff_sha256", "binary_sha256", "build_sha256", "environment_sha256"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_diff_sha256": {"$ref": "#/$defs/sha256"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "build_sha256": {"$ref": "#/$defs/sha256"},
        "environment_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver_basename", "exit_code", "stdout_sha256", "stderr_sha256", "censored", "censor_reason"],
      "properties": {
        "driver_basename": {"const": "power_lanczos_observable_scaling_driver"},
        "exit_code": {"oneOf": [{"type": "null"}, {"type": "integer"}]},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "censored": {"type": "boolean"},
        "censor_reason": {"enum": [null, "timeout", "nonzero_exit", "scheduler_eviction", "missing_metric", "identity_mismatch"]}
      }
    },
    "familyCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cisajs", "cisajscktaltex", "cisajscktalt"],
      "properties": {
        "cisajs": {"$ref": "#/$defs/nonnegativeInteger"},
        "cisajscktaltex": {"$ref": "#/$defs/nonnegativeInteger"},
        "cisajscktalt": {"$ref": "#/$defs/nonnegativeInteger"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "timer_id", "stratum_id", "operator_count", "saved_source_count", "replicate_ordinal", "run_kind", "model", "arithmetic", "Nsite", "NQPFull", "family_counts", "raw_observable_census_sha256", "operator_census_sha256", "timing_seed_sha256", "mpi_world_size", "setup_seconds", "active_seconds", "wall_seconds", "peak_RSS_bytes", "exact_allocated_bytes", "minimum_unique_target_count", "maximum_unique_target_count", "block_count", "coefficient_payload_bytes", "final_payload_bytes", "artifact_payload_bytes", "artifact_files", "amplitude_callback_calls", "normalized_semantic_payload_fnv1a64", "status", "normalized_semantic_payload_sha256"],
      "properties": {
        "schema_version": {"const": 2},
        "timer_id": {"const": "p6c2_observable_source_batch_v2"},
        "stratum_id": {"enum": ["SC-ONEBODY", "SC-QUARTIC", "SC-MIXED", "SC-LOW-REUSE"]},
        "operator_count": {"enum": [1, 32, 128, 512]},
        "saved_source_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "replicate_ordinal": {"type": "integer", "minimum": 0, "maximum": 6},
        "run_kind": {"enum": ["warmup", "measured", "parity", "selftest"]},
        "model": {"enum": ["electronic", "pure_spin"]},
        "arithmetic": {"enum": ["real", "complex"]},
        "Nsite": {"const": 16},
        "NQPFull": {"const": 8},
        "family_counts": {"$ref": "#/$defs/familyCounts"},
        "raw_observable_census_sha256": {"$ref": "#/$defs/sha256"},
        "operator_census_sha256": {"$ref": "#/$defs/sha256"},
        "timing_seed_sha256": {"$ref": "#/$defs/sha256"},
        "mpi_world_size": {"enum": [1, 2, 4]},
        "setup_seconds": {"type": "number", "minimum": 0},
        "active_seconds": {"type": "number", "exclusiveMinimum": 0},
        "wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "peak_RSS_bytes": {"$ref": "#/$defs/nonnegativeInteger"},
        "exact_allocated_bytes": {"$ref": "#/$defs/nonnegativeInteger"},
        "minimum_unique_target_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "maximum_unique_target_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "block_count": {"type": "integer", "minimum": 1},
        "coefficient_payload_bytes": {"$ref": "#/$defs/nonnegativeInteger"},
        "final_payload_bytes": {"$ref": "#/$defs/nonnegativeInteger"},
        "artifact_payload_bytes": {"$ref": "#/$defs/nonnegativeInteger"},
        "artifact_files": {"const": 2},
        "amplitude_callback_calls": {"$ref": "#/$defs/nonnegativeInteger"},
        "normalized_semantic_payload_fnv1a64": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "status": {"const": "PASS"},
        "normalized_semantic_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "bytes", "sha256"],
      "properties": {
        "role": {"enum": ["coefficient_blocks", "final_blocks"]},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.bin$"},
        "bytes": {"$ref": "#/$defs/nonnegativeInteger"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
