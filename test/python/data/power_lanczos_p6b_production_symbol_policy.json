{
  "schema_version": 1,
  "policy_id": "power-lanczos-zero-support-p6b-production-symbols-v1",
  "phase": "P6-B",
  "testing_only": false,
  "production_authorized": true,
  "required_symbols": [
    "mvmc_bounded_krylov_plan_create",
    "mvmc_power_lanczos_build_metadata",
    "mvmc_power_lanczos_contract_id",
    "mvmc_power_lanczos_strict_fp_enabled",
    "mvmc_power_lanczos_validate_production_contract",
    "mvmc_krylov_matrix_measurement_sample",
    "mvmc_krylov_gevp_solve_complex_packed",
    "mvmc_krylov_final_state_policy_create",
    "mvmc_krylov_final_state_chain_step_mixture_rng"
  ],
  "required_binary_strings": [
    "power-lanczos-p6a-production-contract-v2",
    "strict-fp-options:fno-fast-math,ffp-contract-off",
    "complex-fma-contract:c99-complex,record-__FP_FAST_FMA,ffp-contract-off-requested"
  ],
  "forbidden_symbol_regex": [
    "^mvmc_bounded_krylov_testing_",
